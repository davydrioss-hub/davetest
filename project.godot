; After Hours — private co-op network prototype. Godot 4.4.1.
config_version=5

[application]
config/name="After Hours"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Private co-op delivery yard. Host-authoritative LAN and Direct IP."

[autoload]
Profile="*res://scripts/profile.gd"
Session="*res://scripts/session.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.065, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/physics_ticks_per_second=60

